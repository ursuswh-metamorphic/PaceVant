# Only isolated Fuji test wallets. Never paste secrets into chat.
FUJI_RPC_URL='https://avalanche-fuji-c-chain-rpc.publicnode.com'
READ_ADDRESS=0x0000000000000000000000000000000000000000
# Set locally using a dedicated test wallet; optional until Fuji deploy.
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
# Public address derived from your separate agent wallet.
AGENT_ADDRESS=
# Signing requires explicit test-wallet acknowledgement.
FUJI_TEST_WALLETS_ONLY=false
# Retained PoC compatibility variable; not used by Execution Plane.
VITE_NETWORK=fuji

# Canonical runtime defaults to Fuji; treasury mock / treasury local are explicit test modes.
# B_MODE is for explicit legacy b:* tooling; canonical commands use treasury profiles.
B_MODE='fuji'
# Generated once by npm run local or deploy:local; share with A's backend only.
B_API_KEY=

# Local Anvil profile. Bootstrap updates ONLY this profile and preserves the API key.
B_LOCAL_RPC_URL=http://127.0.0.1:8545
B_LOCAL_DEPLOYMENT_FILE=deployments/execution-local.json
B_LOCAL_DATA_DIR=.execution-data
B_LOCAL_RELAYER_PRIVATE_KEY=

# Fuji profile. Existing test wallets may be reused via dotenv interpolation below.
B_FUJI_RPC_URL=${FUJI_RPC_URL}
B_FUJI_DEPLOYMENT_FILE=deployments/execution-fuji.json
B_FUJI_DATA_DIR=.execution-data-fuji
B_FUJI_RELAYER_PRIVATE_KEY=${AGENT_PRIVATE_KEY}
# Loaded only by deployment/config commands, not the API settings model.
B_FUJI_OWNER_PRIVATE_KEY=${DEPLOYER_PRIVATE_KEY}
# Public attestor address. Unified runtime holds attestor/relayer keys; owner stays outside.
B_FUJI_ATTESTOR_ADDRESS=

# A reads this profile via uv run --env-file .env.
PACEVANT_MODE='FUJI'
# Optional: disable bundled assets for an independently hosted frontend.
PACEVANT_SERVE_FRONTEND=true
# Exact comma-separated browser origins; empty for same-origin/proxied hosting.
# Public visitor cookie lifetime; refreshed without changing visitor/history identity.
PACEVANT_JUDGE_SESSION_SECONDS=2592000
PACEVANT_CORS_ORIGINS=
# PACEVANT_B_URL=http://127.0.0.1:8001
# PACEVANT_B_TOKEN=${B_API_KEY}
# PACEVANT_CHAIN_RPC_URL=${B_LOCAL_RPC_URL}
# PACEVANT_RELAYER_ADDRESS=
# PACEVANT_MANDATE_FILE=.control-data/mandate-local.json
# PACEVANT_ORACLE_FILE=.control-data/oracle-local.json
# PACEVANT_OPERATOR_TOKEN=
# PACEVANT_INTERNAL_TOKEN=
# PACEVANT_ATTESTOR_KEY=

# V2.1 operator commands (npm run treasury:*); existing V1 profiles above are preserved.
# init-env generates missing service tokens locally. Never put keys/tokens into this template.
PACEVANT_B_URL=http://127.0.0.1:8001
PACEVANT_B_TOKEN=${B_API_KEY}
PACEVANT_CHAIN_RPC_URL=${B_FUJI_RPC_URL}
PACEVANT_RELAYER_ADDRESS=${AGENT_ADDRESS}
PACEVANT_MANDATE_FILE=.control-data-v2/fuji/mandate.json
PACEVANT_ORACLE_FILE=.control-data-v2/fuji/oracle.json
PACEVANT_ATTESTOR_KEY=
PACEVANT_OPERATOR_TOKEN=
PACEVANT_INTERNAL_TOKEN=
PACEVANT_FUJI_VERIFICATION_RPC='https://avalanche-fuji-c-chain-rpc.publicnode.com'
TREASURY_LOCAL_RPC_URL=http://127.0.0.1:8545
TREASURY_LOCAL_DEPLOYMENT_FILE=deployments/treasury-local-v2.json
TREASURY_FUJI_DEPLOYMENT_FILE=deployments/treasury-fuji-v2.json
TREASURY_LOCAL_DATA_DIR=.execution-data-v2
TREASURY_FUJI_DATA_DIR=.execution-data-fuji-v2
TREASURY_CONTROL_DATA_DIR=.control-data-v2
TREASURY_A_PORT=8000
TREASURY_B_PORT=8001
TREASURY_OWNER_POLICY_APPROVED=false
TREASURY_MAX_WAVAX_PER_SWAP=0
TREASURY_MAX_ORACLE_AGE_SECONDS='300'
TREASURY_SESSION_DURATION_SECONDS='86400'
TREASURY_ORACLE_USDC_USD=1
TREASURY_ORACLE_WAVAX_USD=20
TREASURY_ORACLE_MODE='chainlink'
TREASURY_ORACLE_SOURCE_ID='CHAINLINK_FUJI_CIRCLE_USDC_AVAX_V1'
TREASURY_FUJI_MAX_BLOCK_DRIFT='200'
TREASURY_LOCAL_MAX_BLOCK_DRIFT=3
TREASURY_FUJI_CONFIRMATIONS=2
TREASURY_LOCAL_CONFIRMATIONS=1
TREASURY_MAX_RELATIVE_LOSS_BPS=
TREASURY_MAX_FIXED_LOSS_USD=
TREASURY_ORACLE_BAND_BPS=
TREASURY_POSTCONDITION_TOLERANCE_BPS=
TREASURY_SESSION_RISK_LIMIT_USD=
TREASURY_GLOBAL_DAILY_RISK_LIMIT_USD=

# Optional expected public role addresses. Never put real keys in this template.
TREASURY_OWNER_ADDRESS=
TREASURY_ATTESTOR_ADDRESS=
TREASURY_RELAYER_ADDRESS=

# Planner: rotate = real provider failover; rules is restricted to explicitly selected offline use.
# The private .env can select groq. Goal grammar/alignment remain independently checked.
PACEVANT_PLANNER_PROVIDER='rotate'
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_COMPLETION_TOKENS=512
# Conservative local rolling budgets, below published Free Plan limits.
GROQ_REQUESTS_PER_MINUTE=4
GROQ_REQUESTS_PER_DAY=200
GROQ_TOKENS_PER_MINUTE=4000
GROQ_TOKENS_PER_DAY=80000
GROQ_CACHE_TTL_SECONDS=300
TREASURY_APPROVAL_TTL_SECONDS='300'

# Demo identity: address is used by the current account selector; its private key is reserved, never forwarded.
# Keep the private key only in private .env; never assign owner/attestor/relayer rights.
TREASURY_DEMO_USER_PRIVATE_KEY=''
TREASURY_DEMO_USER_ADDRESS=''
GEMINI_API_KEY=''
GEMINI_MODEL='gemini-3.1-flash-lite'
XINGCHI_API_KEY=''
XINGCHI_BASE_URL='https://xingchiapi.com/v1'
XINGCHI_MODEL='gpt-6.1-sol'
PACEVANT_AI_ROTATION_ORDER='deepseek,groq,gemini,xingchi'
PACEVANT_SHIELD_MODE='wallet_pipeline'
PACEVANT_SHIELD_PROVIDER='deepseek'
PACEVANT_SHIELD_MODEL='deepseek-flash'
PACEVANT_SHIELD_BASE_URL='https://api.deepseek.com'
PACEVANT_SHIELD_API_STYLE='chat_completions'
PACEVANT_SHIELD_USER_AGENT='PaceVant-TaskShield/1.0'
PACEVANT_SHIELD_API_KEY=''
PACEVANT_SHIELD_TEMPERATURE='omit'
PACEVANT_SHIELD_TIMEOUT='20'
PACEVANT_SHIELD_RETRIES='1'
PACEVANT_SHIELD_CONTEXT_CHARS='100000'
PACEVANT_SHIELD_EPSILON='0'
PACEVANT_SHIELD_MAX_REPLANS='0'
PACEVANT_REQUIRE_ITAG='1'
PACEVANT_SHIELD_MAX_OUTPUT_CHARS='65536'
PACEVANT_SHIELD_REASONING_EFFORT=''
PACEVANT_SHIELD_FALLBACKS='groq,gemini,xingchi'
TREASURY_FUJI_FORK_RPC_URL='https://api.avax-test.network/ext/bc/C/rpc'
DEEPSEEK_MODEL='deepseek-flash'
DEEPSEEK_API_KEY=''

# One public demo account: click to select, no code entry. ACCESS_TOKEN is a
# server-only signing secret for automatic demo sessions; never put it in frontend.
# Off-chain sponsor allowance: 0.001 AVAX; max reservation per transaction: 0.0001 AVAX.
PACEVANT_DEMO_ENABLED=0
PACEVANT_DEMO_ACCESS_TOKEN=
PACEVANT_DEMO_INITIAL_CREDIT_WEI=1000000000000000
PACEVANT_DEMO_MAX_TX_FEE_WEI=100000000000000

# Explicit isolated V3 rollout only. Never changes existing Fuji deployment identities.
# Owner-signed local manifest created by the V3 local bootstrap. Empty disables V3.
PACEVANT_V3_MANIFEST_FILE=

# Two-operation MVP migration: disabled until an owner-approved manifest is installed.
PACEVANT_MVP_MANIFEST_FILE=
PACEVANT_MVP_LIVE_ENABLED=0
# System-paid relayer limits, independent of trading loss and retired sponsor credits.
B_MAX_GAS_PER_TX=1500000
B_MAX_GAS_PRICE_WEI=5000000000
B_MAX_TX_FEE_WEI=1000000000000000
B_MAX_DAILY_GAS_EXPENSE_WEI=5000000000000000
