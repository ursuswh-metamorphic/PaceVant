server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location / { try_files $uri $uri/ =404; }
    location = /fuji-wallet { try_files /fuji-wallet.html =404; }
    location = /assets/config.js { add_header Cache-Control "no-store"; }
    location /v1/ {
        proxy_pass ${BACKEND_URL};
        proxy_read_timeout 90s;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /v2/ {
        proxy_pass ${BACKEND_URL};
        proxy_read_timeout 90s;
        proxy_set_header Host $proxy_host;
    }
    location = /healthz { proxy_pass ${BACKEND_URL}; }
    location = /health { proxy_pass ${BACKEND_URL}; }
    location /execution/ {
        proxy_pass ${BACKEND_URL};
        proxy_read_timeout 90s;
        proxy_set_header Host $proxy_host;
    }
    location = /docs { proxy_pass ${BACKEND_URL}; }
    location = /openapi.json { proxy_pass ${BACKEND_URL}; }
}
