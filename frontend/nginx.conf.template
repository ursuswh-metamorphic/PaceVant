server {
    listen 80;
    root /usr/share/nginx/html;
    index treasury-mvp.html;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $treasury_backend ${BACKEND_URL};
    proxy_next_upstream off;
    client_max_body_size 64k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Cache-Control "no-cache";

    location / { try_files $uri $uri/ =404; }
    location = /index.html { return 302 /; }
    location = /fuji-wallet { try_files /fuji-wallet.html =404; }
    location = /assets/config.js { add_header Cache-Control "no-store"; }
    location /v1/ {
        proxy_pass $treasury_backend;
        proxy_read_timeout 90s;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /v2/ {
        proxy_pass $treasury_backend;
        proxy_read_timeout 90s;
        proxy_set_header Host $proxy_host;
    }
    location /mvp/ {
        proxy_pass $treasury_backend;
        proxy_read_timeout 300s;
        proxy_connect_timeout 5s;
        proxy_set_header Idempotency-Key $http_idempotency_key;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /healthz { proxy_pass $treasury_backend; }
    location = /readyz { proxy_pass $treasury_backend; proxy_read_timeout 90s; }
    location = /health { proxy_pass $treasury_backend; }
    location /execution/ {
        proxy_pass $treasury_backend;
        proxy_read_timeout 90s;
        proxy_set_header Host $proxy_host;
    }
    location = /docs { proxy_pass $treasury_backend; }
    location = /openapi.json { proxy_pass $treasury_backend; }
}
