{
  "additionalProperties": false,
  "description": "Read-only SDK pre-attestation check. Never constitutes an APPROVE decision.",
  "properties": {
    "chain_id": {
      "title": "Chain Id",
      "type": "integer"
    },
    "vault_address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Vault Address",
      "type": "string"
    },
    "block_number": {
      "title": "Block Number",
      "type": "integer"
    },
    "block_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Block Hash",
      "type": "string"
    },
    "timestamp": {
      "title": "Timestamp",
      "type": "integer"
    },
    "policy_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "policy_active": {
      "title": "Policy Active",
      "type": "boolean"
    },
    "policy_expires_at": {
      "title": "Policy Expires At",
      "type": "integer"
    },
    "paused": {
      "title": "Paused",
      "type": "boolean"
    },
    "attestor": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Attestor",
      "type": "string"
    },
    "nonce": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Nonce",
      "type": "string"
    },
    "nonce_used": {
      "title": "Nonce Used",
      "type": "boolean"
    },
    "bytecode_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Bytecode Hash",
      "type": "string"
    }
  },
  "required": [
    "chain_id",
    "vault_address",
    "block_number",
    "block_hash",
    "timestamp",
    "policy_hash",
    "policy_active",
    "policy_expires_at",
    "paused",
    "attestor",
    "nonce",
    "nonce_used",
    "bytecode_hash"
  ],
  "title": "ApprovalChainState",
  "type": "object"
}
