{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "policyHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Policyhash",
          "type": "string"
        },
        "evidenceRoot": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Evidenceroot",
          "type": "string"
        },
        "router": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Router",
          "type": "string"
        },
        "tokenIn": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Tokenin",
          "type": "string"
        },
        "tokenOut": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Tokenout",
          "type": "string"
        },
        "amountIn": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Amountin",
          "type": "string"
        },
        "minAmountOut": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Minamountout",
          "type": "string"
        },
        "calldataHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Calldatahash",
          "type": "string"
        },
        "nonce": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Nonce",
          "type": "string"
        },
        "deadline": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Deadline",
          "type": "string"
        }
      },
      "required": [
        "policyHash",
        "evidenceRoot",
        "router",
        "tokenIn",
        "tokenOut",
        "amountIn",
        "minAmountOut",
        "calldataHash",
        "nonce",
        "deadline"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "TreasuryPolicyVault",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "const": "1",
          "title": "Version",
          "type": "string"
        },
        "chainId": {
          "title": "Chainid",
          "type": "integer"
        },
        "verifyingContract": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Verifyingcontract",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "chainId",
        "verifyingContract"
      ],
      "title": "Domain",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "build_id": {
      "title": "Build Id",
      "type": "string"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "signature": {
      "pattern": "^0x[0-9a-f]{130}$",
      "title": "Signature",
      "type": "string"
    },
    "typed_data_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Typed Data Hash",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "build_id",
    "domain",
    "approval",
    "signature",
    "typed_data_hash"
  ],
  "title": "SignedPDR",
  "type": "object"
}
