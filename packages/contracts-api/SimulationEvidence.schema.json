{
  "$defs": {
    "AllowanceRead": {
      "additionalProperties": false,
      "properties": {
        "token": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Token",
          "type": "string"
        },
        "spender": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Spender",
          "type": "string"
        },
        "before": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Before",
          "type": "string"
        },
        "after": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "After",
          "type": "string"
        }
      },
      "required": [
        "token",
        "spender",
        "before",
        "after"
      ],
      "title": "AllowanceRead",
      "type": "object"
    },
    "BalanceRead": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Asset",
          "type": "string"
        },
        "before": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Before",
          "type": "string"
        },
        "after": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "After",
          "type": "string"
        }
      },
      "required": [
        "asset",
        "before",
        "after"
      ],
      "title": "BalanceRead",
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "execution_status": {
          "enum": [
            "SUCCESS",
            "REVERTED",
            "INCONCLUSIVE"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "token_in_delta_base_units": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "title": "Token In Delta Base Units",
          "type": "string"
        },
        "token_out_delta_base_units": {
          "pattern": "^-?(0|[1-9][0-9]*)$",
          "title": "Token Out Delta Base Units",
          "type": "string"
        },
        "unexpected_transfer": {
          "title": "Unexpected Transfer",
          "type": "boolean"
        },
        "unauthorized_approval": {
          "title": "Unauthorized Approval",
          "type": "boolean"
        },
        "gas_used": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Gas Used",
          "type": "string"
        }
      },
      "required": [
        "execution_status",
        "token_in_delta_base_units",
        "token_out_delta_base_units",
        "unexpected_transfer",
        "unauthorized_approval",
        "gas_used"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "EffectEvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "enum": [
            31337,
            43113
          ],
          "title": "Chain Id",
          "type": "integer"
        },
        "vault": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Vault",
          "type": "string"
        },
        "intent_hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Intent Hash",
          "type": "string"
        },
        "policy_hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "calldata_hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Calldata Hash",
          "type": "string"
        },
        "block_number": {
          "minimum": 0,
          "title": "Block Number",
          "type": "integer"
        },
        "block_hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Block Hash",
          "type": "string"
        },
        "timestamp": {
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        },
        "registry_hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Registry Hash",
          "type": "string"
        },
        "balances": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/BalanceRead"
            },
            {
              "$ref": "#/$defs/BalanceRead"
            }
          ],
          "title": "Balances",
          "type": "array"
        },
        "allowances": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/AllowanceRead"
            },
            {
              "$ref": "#/$defs/AllowanceRead"
            }
          ],
          "title": "Allowances",
          "type": "array"
        },
        "unexpected_transfer": {
          "title": "Unexpected Transfer",
          "type": "boolean"
        },
        "unauthorized_approval": {
          "title": "Unauthorized Approval",
          "type": "boolean"
        },
        "simulator_version": {
          "const": "guarded-v2.1",
          "default": "guarded-v2.1",
          "title": "Simulator Version",
          "type": "string"
        },
        "adapter_version": {
          "default": "mock-swap-v1",
          "enum": [
            "mock-swap-v1",
            "lfj-v1-fuji-v1"
          ],
          "title": "Adapter Version",
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "vault",
        "intent_hash",
        "policy_hash",
        "calldata_hash",
        "block_number",
        "block_hash",
        "timestamp",
        "registry_hash",
        "balances",
        "allowances",
        "unexpected_transfer",
        "unauthorized_approval"
      ],
      "title": "EffectEvidenceV2",
      "type": "object"
    },
    "StressTest": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCESS_SAFE",
            "PROTECTED_REVERT",
            "UNSAFE_EXECUTION",
            "INCONCLUSIVE"
          ],
          "title": "Status",
          "type": "string"
        },
        "scenario_hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Scenario Hash",
          "type": "string"
        },
        "output_base_units": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Base Units"
        },
        "revert_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revert Reason"
        }
      },
      "required": [
        "scenario_id",
        "status",
        "scenario_hash"
      ],
      "title": "StressTest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "effects_v2": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectEvidenceV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "intent_id": {
      "title": "Intent Id",
      "type": "string"
    },
    "build_id": {
      "title": "Build Id",
      "type": "string"
    },
    "chain_id": {
      "title": "Chain Id",
      "type": "integer"
    },
    "vault_address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Vault Address",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "calldata_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Calldata Hash",
      "type": "string"
    },
    "nonce": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Nonce",
      "type": "string"
    },
    "deadline": {
      "title": "Deadline",
      "type": "integer"
    },
    "fork_block": {
      "title": "Fork Block",
      "type": "integer"
    },
    "bytecode_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Bytecode Hash",
      "type": "string"
    },
    "simulation_mode": {
      "const": "LOCAL_TEST_ATTESTOR",
      "title": "Simulation Mode",
      "type": "string"
    },
    "baseline": {
      "$ref": "#/$defs/Baseline"
    },
    "stress_tests": {
      "items": {
        "$ref": "#/$defs/StressTest"
      },
      "title": "Stress Tests",
      "type": "array"
    },
    "verification_status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "INCONCLUSIVE"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "parser_version": {
      "const": "extractor-v1",
      "default": "extractor-v1",
      "title": "Parser Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "MOCK_FIXTURE",
        "REAL_LOCAL_SIM",
        "FORK_SIM"
      ],
      "title": "Source",
      "type": "string"
    },
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "evidence_manifest_ref": {
      "title": "Evidence Manifest Ref",
      "type": "string"
    },
    "evidence_root": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Evidence Root",
      "type": "string"
    }
  },
  "required": [
    "intent_id",
    "build_id",
    "chain_id",
    "vault_address",
    "policy_hash",
    "calldata_hash",
    "nonce",
    "deadline",
    "fork_block",
    "bytecode_hash",
    "simulation_mode",
    "baseline",
    "stress_tests",
    "verification_status",
    "source",
    "artifact_refs",
    "evidence_manifest_ref",
    "evidence_root"
  ],
  "title": "SimulationEvidence",
  "type": "object"
}
