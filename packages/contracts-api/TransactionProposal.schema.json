{
  "additionalProperties": false,
  "properties": {
    "intent_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Intent Id",
      "type": "string"
    },
    "mandate_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Mandate Id",
      "type": "string"
    },
    "mandate_version": {
      "minimum": 1,
      "title": "Mandate Version",
      "type": "integer"
    },
    "action": {
      "const": "SWAP_EXACT_INPUT",
      "title": "Action",
      "type": "string"
    },
    "chain_id": {
      "exclusiveMinimum": 0,
      "title": "Chain Id",
      "type": "integer"
    },
    "vault_address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Vault Address",
      "type": "string"
    },
    "router": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Router",
      "type": "string"
    },
    "token_in": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Token In",
      "type": "string"
    },
    "token_out": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Token Out",
      "type": "string"
    },
    "amount_in_base_units": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Amount In Base Units",
      "type": "string"
    },
    "slippage_bps": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Slippage Bps",
      "type": "integer"
    },
    "recipient": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Recipient",
      "type": "string"
    },
    "deadline": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "Deadline",
      "type": "integer"
    },
    "user_goal_reason": {
      "maxLength": 4096,
      "title": "User Goal Reason",
      "type": "string"
    }
  },
  "required": [
    "intent_id",
    "mandate_id",
    "mandate_version",
    "action",
    "chain_id",
    "vault_address",
    "router",
    "token_in",
    "token_out",
    "amount_in_base_units",
    "slippage_bps",
    "recipient",
    "deadline",
    "user_goal_reason"
  ],
  "title": "TransactionProposal",
  "type": "object"
}
