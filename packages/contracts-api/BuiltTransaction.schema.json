{
  "additionalProperties": false,
  "properties": {
    "build_id": {
      "title": "Build Id",
      "type": "string"
    },
    "intent_id": {
      "title": "Intent Id",
      "type": "string"
    },
    "chain_id": {
      "title": "Chain Id",
      "type": "integer"
    },
    "vault_address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Vault Address",
      "type": "string"
    },
    "router": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Router",
      "type": "string"
    },
    "token_in": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Token In",
      "type": "string"
    },
    "token_out": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Token Out",
      "type": "string"
    },
    "amount_in_base_units": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Amount In Base Units",
      "type": "string"
    },
    "min_amount_out_base_units": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Min Amount Out Base Units",
      "type": "string"
    },
    "router_calldata": {
      "pattern": "^0x(?:[0-9a-f]{2})*$",
      "title": "Router Calldata",
      "type": "string"
    },
    "calldata_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Calldata Hash",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^0x[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "nonce": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Nonce",
      "type": "string"
    },
    "deadline": {
      "title": "Deadline",
      "type": "integer"
    },
    "quote_ref": {
      "title": "Quote Ref",
      "type": "string"
    },
    "adapter_version": {
      "default": "mock-swap-v1",
      "enum": [
        "mock-swap-v1",
        "lfj-v1-fuji-v1"
      ],
      "title": "Adapter Version",
      "type": "string"
    }
  },
  "required": [
    "build_id",
    "intent_id",
    "chain_id",
    "vault_address",
    "router",
    "token_in",
    "token_out",
    "amount_in_base_units",
    "min_amount_out_base_units",
    "router_calldata",
    "calldata_hash",
    "policy_hash",
    "nonce",
    "deadline",
    "quote_ref"
  ],
  "title": "BuiltTransaction",
  "type": "object"
}
