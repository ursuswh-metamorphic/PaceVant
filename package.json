{
  "name": "ai-treasury-security",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Modular Python treasury backend, browser dashboard and Solidity guard",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "uv sync --locked && uv run --locked python tools/contracts/bootstrap.py",
    "compile": "uv run --locked python tools/contracts/foundry.py forge build",
    "build": "npm run compile",
    "anvil": "uv run --locked python tools/contracts/foundry.py anvil --host 127.0.0.1 --chain-id 31337 --hardfork cancun",
    "deploy:local": "uv run --locked treasury deploy --network local",
    "deploy:fuji": "uv run --locked treasury deploy --network fuji",
    "demo": "uv run --locked treasury demo --network local",
    "local": "uv run --locked treasury local",
    "dev": "uv run --locked python -m treasury_backend.api.serve",
    "dev:local": "uv run --locked treasury local",
    "dev:fuji": "uv run --locked treasury serve --network fuji",
    "config": "uv run --locked python -m treasury_backend.operations.execution config",
    "config:fuji": "uv run --locked python -m treasury_backend.operations.execution config --network fuji",
    "test:contracts": "uv run --locked python tools/contracts/foundry.py forge test -vv",
    "test:python": "uv run --locked python -m pytest -q",
    "test:integration": "node backend/tests/integration/eip712-golden.mjs && node backend/tests/integration/eip712-v2-golden.mjs",
    "test:consumer": "npm run compile && uv run --locked python -m pytest backend/tests/execution/test_consumer_contract.py -q",
    "test:ab": "npm run compile && uv run --locked python -m pytest backend/tests/execution/test_ab_integration.py -q",
    "test": "npm run test:contracts && npm run test:python && npm run test:integration",
    "scan:secrets": "uv run --locked python tools/quality/scan_secrets.py",
    "check": "npm test && npm run scan:secrets",
    "schemas": "uv run --locked python -m treasury_backend.operations.execution schemas",
    "fixtures": "uv run --locked python -m treasury_backend.operations.execution fixtures",
    "golden": "uv run --locked python -m treasury_backend.operations.execution golden",
    "golden:v2": "uv run --locked python tools/contracts/generate_v2_vectors.py",
    "treasury:init": "uv run --locked treasury init-env",
    "treasury:doctor": "uv run --locked treasury doctor --network fuji --live",
    "treasury:local": "uv run --locked treasury local",
    "treasury:local:smoke": "uv run --locked treasury local --once",
    "treasury:deploy:fuji": "uv run --locked treasury deploy --network fuji",
    "treasury:prepare:fuji": "uv run --locked treasury prepare --network fuji",
    "treasury:fuji": "uv run --locked treasury serve --network fuji",
    "treasury:demo:fuji": "uv run --locked treasury demo --network fuji",
    "treasury:renew:fuji": "uv run --locked treasury renew-session --network fuji",
    "benchmark:protocol": "uv run --locked python tools/evaluation/evaluate_protocol.py",
    "b:setup": "npm run setup",
    "b:compile": "npm run compile",
    "b:anvil": "npm run anvil",
    "b:deploy:local": "uv run --locked python -m treasury_backend.operations.execution deploy-local",
    "b:deploy:fuji": "uv run --locked python -m treasury_backend.operations.execution deploy-fuji",
    "b:demo": "uv run --locked python -m treasury_backend.operations.execution demo",
    "b:api": "uv run --locked python -m treasury_backend.operations.execution serve",
    "b:api:fuji": "uv run --locked python -m treasury_backend.operations.execution serve --network fuji",
    "b:test:contracts": "npm run test:contracts",
    "b:test": "npm run test:python",
    "b:schemas": "npm run schemas",
    "b:golden": "npm run golden",
    "b:check": "npm run check",
    "b:scan-secrets": "npm run scan:secrets",
    "check:frontend": "node tools/quality/check_frontend.mjs"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "viem": "2.57.19"
  }
}
