# DOC STATUS: HISTORICAL_TEMPLATE — incomplete for current Fuji demo profile.
# See deploy/README.md and docs/AI_Treasury_Security_System_Design_v2.1.md.
# Old TTL/session/provider defaults and missing Shield/ITAG/demo flags need reconciliation.
# Copy only after reconciliation to an ignored private env file; no ${...} aliases.
# Do not add owner/deployer private keys. Contract deployment happens separately.
B_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
B_FUJI_RELAYER_PRIVATE_KEY=
PACEVANT_ATTESTOR_KEY=
B_API_KEY=
PACEVANT_OPERATOR_TOKEN=
PACEVANT_INTERNAL_TOKEN=
# Optional real planner. Groq errors refuse planning; they never fall back to fixtures.
PACEVANT_PLANNER_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_COMPLETION_TOKENS=512
GROQ_REQUESTS_PER_MINUTE=4
GROQ_REQUESTS_PER_DAY=200
GROQ_TOKENS_PER_MINUTE=4000
GROQ_TOKENS_PER_DAY=80000
GROQ_CACHE_TTL_SECONDS=300
# Optional provider failover: set PACEVANT_PLANNER_PROVIDER=rotate to enable.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
XINGCHI_API_KEY=
XINGCHI_BASE_URL=https://xingchiapi.com/v1
XINGCHI_MODEL=gpt-6.1-sol
PACEVANT_AI_ROTATION_ORDER=gemini,groq,xingchi
FUJI_TEST_WALLETS_ONLY=true
PACEVANT_SERVE_FRONTEND=false
# For a separately hosted static frontend; empty when using the Nginx proxy.
PACEVANT_CORS_ORIGINS=
TREASURY_ORACLE_MODE=chainlink
TREASURY_ORACLE_SOURCE_ID=CHAINLINK_FUJI_CIRCLE_USDC_AVAX_V1
TREASURY_FUJI_DEPLOYMENT_FILE=/etc/secrets/treasury-fuji-v2.json
TREASURY_SERVER_DATA_DIR=/var/data
PACEVANT_FUJI_VERIFICATION_RPC=https://api.avax-test.network/ext/bc/C/rpc
# Must match the already deployed owner policy exactly.
TREASURY_OWNER_POLICY_APPROVED=true
TREASURY_MAX_RELATIVE_LOSS_BPS=300
TREASURY_MAX_FIXED_LOSS_USD=0
TREASURY_ORACLE_BAND_BPS=100
TREASURY_POSTCONDITION_TOLERANCE_BPS=40
TREASURY_SESSION_RISK_LIMIT_USD=10
TREASURY_GLOBAL_DAILY_RISK_LIMIT_USD=20
TREASURY_MAX_WAVAX_PER_SWAP=0
TREASURY_MAX_ORACLE_AGE_SECONDS=180
TREASURY_APPROVAL_TTL_SECONDS=180
TREASURY_SESSION_DURATION_SECONDS=3600
TREASURY_ORACLE_USDC_USD=1
TREASURY_ORACLE_WAVAX_USD=20
TREASURY_FUJI_MAX_BLOCK_DRIFT=120
TREASURY_FUJI_CONFIRMATIONS=2
