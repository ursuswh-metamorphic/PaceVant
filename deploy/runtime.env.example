# Copy locally to an ignored private env file; use actual values, not ${...} aliases.
# Do not add owner/deployer private keys. Contract deployment happens separately.
B_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
B_FUJI_RELAYER_PRIVATE_KEY=
PACEVANT_ATTESTOR_KEY=
B_API_KEY=
PACEVANT_OPERATOR_TOKEN=
PACEVANT_INTERNAL_TOKEN=
FUJI_TEST_WALLETS_ONLY=true
TREASURY_FUJI_DEPLOYMENT_FILE=/etc/secrets/treasury-fuji-v2.json
TREASURY_SERVER_DATA_DIR=/var/data
PACEVANT_FUJI_VERIFICATION_RPC=https://api.avax-test.network/ext/bc/C/rpc
# Must match the already deployed owner policy exactly.
TREASURY_OWNER_POLICY_APPROVED=true
TREASURY_MAX_RELATIVE_LOSS_BPS=300
TREASURY_MAX_FIXED_LOSS_USD=0
TREASURY_ORACLE_BAND_BPS=100
TREASURY_POSTCONDITION_TOLERANCE_BPS=40
TREASURY_SESSION_RISK_LIMIT_USD=10
TREASURY_GLOBAL_DAILY_RISK_LIMIT_USD=20
TREASURY_MAX_WAVAX_PER_SWAP=0
TREASURY_MAX_ORACLE_AGE_SECONDS=60
TREASURY_SESSION_DURATION_SECONDS=3600
TREASURY_ORACLE_USDC_USD=1
TREASURY_ORACLE_WAVAX_USD=20
TREASURY_FUJI_MAX_BLOCK_DRIFT=30
TREASURY_FUJI_CONFIRMATIONS=2
