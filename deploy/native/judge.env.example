# Copy to /etc/pacevant/judge.env, root:pacevant 0640. systemd syntax: literal values, no ${...} aliases.
# NO Owner, public Attestor, public Relayer keys or operator tokens in this service.
PACEVANT_JUDGE_ENABLED=1
PACEVANT_JUDGE_SECURE_COOKIE=1
PACEVANT_JUDGE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
PACEVANT_JUDGE_VISITOR_DAILY_LIMIT=6
PACEVANT_JUDGE_IP_HOURLY_LIMIT=6
PACEVANT_JUDGE_GLOBAL_DAILY_LIMIT=30
PACEVANT_JUDGE_TIMEOUT_SECONDS=240
PACEVANT_JUDGE_ORACLE_WAIT_SECONDS=45
PACEVANT_SHIELD_MODE=wallet_pipeline
PACEVANT_SHIELD_PROVIDER=deepseek
PACEVANT_SHIELD_MODEL=deepseek-flash
PACEVANT_SHIELD_BASE_URL=https://api.deepseek.com
PACEVANT_SHIELD_API_STYLE=chat_completions
PACEVANT_SHIELD_TIMEOUT=15
PACEVANT_SHIELD_RETRIES=0
PACEVANT_SHIELD_CONTEXT_CHARS=100000
PACEVANT_SHIELD_MAX_OUTPUT_CHARS=65536
PACEVANT_SHIELD_MAX_REPLANS=0
PACEVANT_SHIELD_FALLBACKS=
DEEPSEEK_API_KEY=
# Optional existing reviewed failovers; enable deliberately with matching API/model settings.
GROQ_API_KEY=
GEMINI_API_KEY=
